# ---- AI provider (free tiers). Set one key; with none, replies are scripted. ----
# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: force a provider (gemini | groq | demo) and choose models.
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- GitHub App, for private repositories (see README) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name, used for the "choose repositories" link.
GITHUB_APP_SLUG=

# Encrypts the session cookie. Required in production. openssl rand -base64 32
SESSION_SECRET=

# Optional: a fine-grained token with public-repository read access only.
# Raises GitHub's limit for signed-out visitors from 60 to 5,000 requests an hour.
GITHUB_TOKEN=

# Optional usage limits.
DAILY_MESSAGE_LIMIT=40
GLOBAL_MESSAGES_PER_MINUTE=20
